#!/usr/bin/env bash
# jarvos-update-restart-stale — make an update take effect without a reboot,
# as far as that can be done safely and unattended.
#
# After a transaction, services keep running the libraries they started with
# (jarvos-update-stale finds them). This restarts the ones that can be
# restarted without anyone noticing:
#
#   systemd (PID 1)   daemon-reexec, which is how systemd replaces itself
#   system services   try-restart, but only units a package ships (their
#                     unit file is under /usr/lib/systemd). A unit someone
#                     wrote under /etc is somebody's running work, and the
#                     update has no business interrupting it.
#
# Never restarted, because a restart would end the session, the login, the
# network a remote user is connected through, or a file transfer in flight:
# SKIP below. The desktop and
# its apps are never touched either; the update panel lists them instead.
#
# Non-fatal throughout: a service that will not restart is reported and the
# rest still get their turn.
#
# Seams: JARVOS_PROC (via jarvos-update-stale), JARVOS_STALE_SKIP (an extra
#        regex of units to leave alone)

set -uo pipefail

# shellcheck source=lib/jarvos-common.sh
_lib="$(dirname "$(realpath "$0")")/../lib/jarvos-common.sh"
if [[ -r "$_lib" ]]; then source "$_lib"; else source /usr/share/jarvos/lib/jarvos-common.sh; fi
unset _lib

SKIP='^(dbus|dbus-broker|systemd-logind|display-manager|sddm|gdm|lightdm|greetd|user@.*|getty@.*|serial-getty@.*|autovt@.*|NetworkManager|wpa_supplicant|iwd|systemd-networkd|systemd-resolved|tailscaled|docker|containerd|libvirtd|virtqemud|polkit|smb|nmb)\.service$'
EXTRA_SKIP="${JARVOS_STALE_SKIP:-}"

# Root sees every process; the sibling is found by path so sudo's own PATH
# does not matter.
stale_cmd="$(dirname "$(realpath "$0")")/jarvos-update-stale"
[[ -x "$stale_cmd" ]] || stale_cmd="$(command -v jarvos-update-stale)"
stale="$(sudo env JARVOS_PROC="${JARVOS_PROC:-/proc}" "$stale_cmd" 2>/dev/null)"
[[ -n "$stale" ]] || exit 0

echo "Applying the update to running services"

if grep -q '^init' <<<"$stale"; then
    sudo systemctl daemon-reexec && echo "  systemd re-executed" ||
        echo "jarvos: systemd could not re-execute itself" >&2
fi

restarted=() failed=() left=()
while IFS= read -r unit; do
    [[ -n "$unit" ]] || continue
    if [[ "$unit" =~ $SKIP ]] || { [[ -n "$EXTRA_SKIP" ]] && [[ "$unit" =~ $EXTRA_SKIP ]]; }; then
        left+=("$unit")
        continue
    fi
    fragment="$(systemctl show "$unit" -p FragmentPath --value 2>/dev/null)"
    if [[ "$fragment" != /usr/lib/systemd/* ]]; then
        left+=("$unit")
        continue
    fi
    if timeout 90 sudo systemctl try-restart "$unit"; then
        restarted+=("$unit")
    else
        failed+=("$unit")
    fi
# Services only: a .mount here is a FUSE filesystem (ntfs-3g), and
# "restarting" it would unmount a disk out from under whoever is using it.
done < <(awk -F'\t' '$1 == "system" && $2 ~ /\.service$/ { print $2 }' <<<"$stale" | sort -u)

((${#restarted[@]} == 0)) || echo "  restarted: ${restarted[*]}"
((${#failed[@]} == 0)) || echo "jarvos: could not restart: ${failed[*]}" >&2
((${#left[@]} == 0)) || echo "  left for you (they would interrupt something): ${left[*]}"
exit 0
