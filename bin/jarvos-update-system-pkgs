#!/usr/bin/env bash
# jarvos-update-system-pkgs — the main pacman transaction, with the failures
# an unattended run is known to hit resolved by rule.
#
# --noconfirm answers every question with its default, and for some of them
# the default IS the failure. Each rule below fixes exactly one of those, and
# each is applied at most once per run, so a rule that did not help cannot
# loop:
#
#   stale lock            an interrupted pacman's db.lck, removed only when no
#                         package manager is alive to own it
#   conflicting packages  "Remove X? [y/N]" — retried with --ask=4, the ALPM
#                         question bit that flips that one default to yes
#   files in the way      "exists in filesystem" — retried with --overwrite
#                         for exactly those paths, and only when no package
#                         owns them (debris from a manual install). A file
#                         another package owns is a real conflict and is
#                         never overwritten.
#   bad signature         the keyring repopulated, the corrupt download
#                         dropped from the cache
#
# Anything else is not a rule's to guess at: the step fails, and jarvos-update
# hands it to the resolver.
#
# Exit 75 means the network failed, not the system; retrying later is the
# remedy, and nothing downstream should repair or roll back over it.

set -euo pipefail

# shellcheck source=lib/jarvos-common.sh
_lib="$(dirname "$(realpath "$0")")/../lib/jarvos-common.sh"
if [[ -r "$_lib" ]]; then source "$_lib"; else source /usr/share/jarvos/lib/jarvos-common.sh; fi
unset _lib

log="$(mktemp)"
trap 'rm -f "$log"' EXIT

extra=()
applied=" "
rc=0

# One more attempt per rule, plus the first.
for _ in 1 2 3 4 5; do
    jarvos_pacman_unlock_stale || true

    echo "Updating system packages"
    rc=0
    sudo pacman -Syu --noconfirm "${extra[@]}" 2>&1 | tee "$log" || rc=${PIPESTATUS[0]}
    ((rc == 0)) && exit 0

    if jarvos_network_failure "$log"; then
        echo "jarvos: the package mirrors could not be reached — retry later" >&2
        exit "$JARVOS_EX_TEMPFAIL"
    fi

    if [[ "$applied" != *" lock "* ]] && grep -q 'unable to lock database' "$log"; then
        applied+="lock "
        jarvos_pacman_unlock_stale && continue
        exit "$rc"
    fi

    if [[ "$applied" != *" conflict "* ]] && grep -q 'are in conflict' "$log"; then
        applied+="conflict "
        echo "jarvos: conflicting packages — accepting the replacement pacman proposes"
        extra+=(--ask=4)
        continue
    fi

    if [[ "$applied" != *" files "* ]] && grep -q 'exists in filesystem' "$log"; then
        applied+="files "
        owned=0
        paths=()
        while IFS= read -r path; do
            [[ -n "$path" ]] || continue
            if pacman -Qo "$path" >/dev/null 2>&1; then
                echo "jarvos: $path belongs to another package — not overwriting it" >&2
                owned=1
            else
                paths+=("$path")
            fi
        done < <(grep 'exists in filesystem' "$log" | grep -v 'owned by' |
            sed -E 's/^[^:]*: (\/.*) exists in filesystem.*$/\1/' | grep '^/' | sort -u)
        # Pacman's newer wording names the owner itself.
        grep 'exists in filesystem' "$log" | grep -q 'owned by' && owned=1
        if ((owned == 0 && ${#paths[@]} > 0)); then
            echo "jarvos: ${#paths[@]} unowned file(s) in the way — overwriting exactly those"
            for path in "${paths[@]}"; do extra+=(--overwrite "$path"); done
            continue
        fi
        exit "$rc"
    fi

    if [[ "$applied" != *" keys "* ]] &&
        grep -qE 'invalid or corrupted package|signature from .* is (unknown trust|invalid|marginal trust)|unknown public key|could not be looked up remotely' "$log"; then
        applied+="keys "
        echo "jarvos: signature failure — repopulating the keyring and dropping corrupt downloads"
        sudo pacman-key --populate archlinux || true
        while IFS= read -r file; do
            [[ -n "$file" ]] && sudo rm -f "$file"
        done < <(grep -oE 'File [^ ]+\.pkg\.tar\.[a-z0-9]+ is corrupted' "$log" | awk '{print $2}')
        continue
    fi

    exit "$rc"
done

exit "$rc"
