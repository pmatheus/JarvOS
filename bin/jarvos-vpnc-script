#!/usr/bin/env bash
# Keep corporate DNS scoped to the profile's domains while delegating all
# interface and route handling to gpclient's packaged vpnc-script.

set -uo pipefail

UPSTREAM_SCRIPT="${JARVOS_VPN_UPSTREAM_SCRIPT:-/usr/libexec/gpclient/vpnc-script}"
DNS_DOMAINS="${JARVOS_VPN_DNS_DOMAINS:-}"

if [[ ! -x "$UPSTREAM_SCRIPT" ]]; then
    printf 'jarvos-vpnc-script: upstream script is not executable: %s\n' "$UPSTREAM_SCRIPT" >&2
    exit 1
fi

_routed_domains=()
if [[ -n "$DNS_DOMAINS" ]]; then
    # Format as route-only domains (~domain1,~domain2) so systemd-resolved
    # routes corporate queries through the tunnel DNS without polluting
    # the search list or global resolver configuration.
    IFS=',' read -ra _raw_domains <<< "$DNS_DOMAINS"
    for _d in "${_raw_domains[@]}"; do
        [[ -z "$_d" ]] && continue
        if [[ "$_d" == ~* ]]; then
            _routed_domains+=("$_d")
        else
            _routed_domains+=("~$_d")
        fi
    done
    CISCO_SPLIT_DNS="$(IFS=','; echo "${_routed_domains[*]}")"
    export CISCO_SPLIT_DNS
fi

"$UPSTREAM_SCRIPT" "$@"
status=$?

if (( status == 0 )) && [[ -n "$DNS_DOMAINS" && "${reason:-}" == "connect" && -n "${TUNDEV:-}" ]]; then
    if command -v resolvectl >/dev/null 2>&1; then
        resolvectl default-route "$TUNDEV" no 2>/dev/null || true
        resolvectl domain "$TUNDEV" "${_routed_domains[@]}" 2>/dev/null || true
    fi
elif [[ "${reason:-}" == "disconnect" && -n "${TUNDEV:-}" ]]; then
    if command -v resolvectl >/dev/null 2>&1; then
        resolvectl revert "$TUNDEV" 2>/dev/null || true
    fi
fi

exit "$status"
