#!/usr/bin/env bash
# jarvos:summary=Open and query the Chinese language learning scratchpad for field operations
# jarvos:args=[open|list|search <query>|audio <text>|mine]
# jarvos:examples=jarvos-chinese | jarvos-chinese search "backdoor" | jarvos-chinese audio "免杀"

set -euo pipefail

# shellcheck source=lib/jarvos-common.sh
_lib="$(dirname "$(realpath "$0")")/../lib/jarvos-common.sh"
if [[ -r "$_lib" ]]; then source "$_lib"; else source /usr/share/jarvos/lib/jarvos-common.sh; fi
unset _lib

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/jarvos/chinese"
REPO_DATA="$(dirname "$(realpath "$0")")/../share/jarvos/chinese"

# Ensure local data directory is populated
mkdir -p "$DATA_DIR"
if [[ -f "$REPO_DATA/vocabulary.json" && ! -f "$DATA_DIR/vocabulary.json" ]]; then
    cp "$REPO_DATA/vocabulary.json" "$DATA_DIR/vocabulary.json"
fi
if [[ -f "$REPO_DATA/index.html" && ! -f "$DATA_DIR/index.html" ]]; then
    cp "$REPO_DATA/index.html" "$DATA_DIR/index.html"
fi

VOCAB_FILE="$DATA_DIR/vocabulary.json"
HTML_FILE="$DATA_DIR/index.html"

cmd="${1:-open}"
shift || true

case "$cmd" in
    open)
        if command -v google-chrome-stable >/dev/null 2>&1; then
            exec google-chrome-stable --user-data-dir="$DATA_DIR/chrome-profile" --app="file://$HTML_FILE" --class="jarvos-chinese" "$@" >/dev/null 2>&1 &
        elif command -v chromium >/dev/null 2>&1; then
            exec chromium --user-data-dir="$DATA_DIR/chrome-profile" --app="file://$HTML_FILE" --class="jarvos-chinese" "$@" >/dev/null 2>&1 &
        else
            xdg-open "file://$HTML_FILE" >/dev/null 2>&1 &
        fi
        ;;

    list)
        format="text"
        for arg in "$@"; do
            [[ "$arg" == "--json" ]] && format="json"
        done

        if [[ "$format" == "json" ]]; then
            cat "$VOCAB_FILE"
        else
            python3 - "$VOCAB_FILE" << 'PYEOF'
import json, sys
data = json.load(open(sys.argv[1]))
print(f"{'CATEGORY':<24} {'ENGLISH':<32} {'SIMPLIFIED':<12} {'PINYIN'}")
print(f"{'-'*24} {'-'*32} {'-'*12} {'-'*20}")
for item in data:
    print(f"{item['category']:<24} {item['english']:<32} {item['simplified']:<12} {item['pinyin']}")
PYEOF
        fi
        ;;

    search)
        query="${1:-}"
        [[ -n "$query" ]] || die "usage: jarvos-chinese search <query>"
        python3 - "$VOCAB_FILE" "$query" << 'PYEOF'
import json, sys
data = json.load(open(sys.argv[1]))
query = sys.argv[2].lower()

found = 0
for item in data:
    en = item['english'].lower()
    simp = item['simplified']
    trad = item['traditional']
    py = item['pinyin'].lower()
    exp = item['explanation'].lower()
    if query in en or query in simp or query in trad or query in py or query in exp:
        found += 1
        print(f"\n[{found}] {item['english']}")
        print(f"    Chinese:  {item['simplified']} (Traditional: {item['traditional']})")
        print(f"    Pinyin:   {item['pinyin']}")
        print(f"    Meaning:  {item['explanation']}")
        bd = " + ".join([f"{b['char']} ({b['pinyin']}: {b['meaning']})" for b in item['breakdown']])
        print(f"    Elements: {bd}")

if found == 0:
    print(f"No vocabulary matched '{query}'")
PYEOF
        ;;

    audio)
        text="${1:-}"
        [[ -n "$text" ]] || die "usage: jarvos-chinese audio <chinese_text>"
        url="https://translate.google.com/translate_tts?ie=UTF-8&q=$(python3 -c 'import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))' "$text")&tl=zh-CN&client=tw-ob"
        if command -v mpg123 >/dev/null 2>&1; then
            exec mpg123 -q "$url"
        else
            die "mpg123 not installed for CLI audio playback"
        fi
        ;;

    mine)
        echo "Mining AI agent transcripts for frequent vocabulary patterns..."
        python3 - << 'PYEOF'
import glob, json, re, collections

words = collections.Counter()
# 1. Antigravity transcripts
for f in glob.glob("/home/user/.gemini/antigravity-cli/brain/*/.system_generated/logs/transcript.jsonl"):
    try:
        with open(f, "r", errors="ignore") as fp:
            for line in fp:
                try:
                    obj = json.loads(line)
                    if obj.get("type") == "USER_INPUT":
                        tokens = re.findall(r"\b[a-zA-Z]{4,}\b", obj.get("content", "").lower())
                        words.update(tokens)
                except Exception:
                    pass
    except Exception:
        pass

# 2. Claude history
try:
    with open("/home/user/.claude/history.jsonl", "r", errors="ignore") as fp:
        for line in fp:
            try:
                obj = json.loads(line)
                disp = obj.get("display", "")
                if not disp.startswith("/"):
                    tokens = re.findall(r"\b[a-zA-Z]{4,}\b", disp.lower())
                    words.update(tokens)
            except Exception:
                pass
except Exception:
    pass

print(f"Discovered {len(words)} distinct terms across AI sessions.")
print("Top 15 frequent terms in your agent interactions:")
for w, count in words.most_common(15):
    print(f"  - {w:<16} ({count} occurrences)")
PYEOF
        ;;

    -h|--help)
        sed -n '2,4p' "$0"
        exit 0
        ;;

    *)
        die "unknown subcommand: $cmd (available: open, list, search, audio, mine)"
        ;;
esac
