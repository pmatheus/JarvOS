#!/usr/bin/env bash
# JarvOS optional modules, presented by the Omarchy command menu.
set -euo pipefail
pending=${JARVOS_FIRST_RUN_MARKER:-/var/lib/jarvos/first-run-pending}
done_file="${XDG_STATE_HOME:-$HOME/.local/state}/jarvos/first-run-done"
case "${1:-}" in
    -h|--help)
        echo 'Usage: jarvos-setup [--first-run|--done|--install MODULE ...]'
        exit 0 ;;
    --first-run)
        [[ -e "$pending" && ! -e "$done_file" ]] || exit 0 ;;
    --done)
        mkdir -p "$(dirname "$done_file")"
        touch "$done_file"
        exit 0 ;;
    --install)
        shift
        [[ $# -gt 0 ]] || { echo 'Supply at least one module.' >&2; exit 2; }
        base=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
        installer="$base/scripts/jarvos-module-install"
        [[ -x "$installer" ]] || installer=/usr/share/jarvos/scripts/jarvos-module-install
        echo "Installing modules: $*"
        echo "Progress and logs: ${XDG_STATE_HOME:-$HOME/.local/state}/jarvos/"
        exec "$installer" "$@"
        ;;
    '') ;;
    *) echo 'Unknown setup option. Use --help.' >&2; exit 2 ;;
esac
for _ in {1..30}; do
    if [[ $(jarvos-shell status 2>/dev/null || true) == ok ]]; then
        exec jarvos-shell ipc shell summon omarchy.menu '{"menu":"jarvos-setup"}'
    fi
    sleep 1
done
echo 'jarvos-setup: the desktop did not become ready.' >&2
exit 1
