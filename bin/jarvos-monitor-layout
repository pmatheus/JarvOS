#!/usr/bin/env bash
# jarvos-monitor-layout — enforce physical monitor order, independent of Hyprland config.
#
# This is the self-healing backstop: even if the Hyprland config tree is wiped,
# regenerated by an upstream resync, or otherwise drifts, this re-applies the
# correct left->center->right layout when Hyprland comes up.
#
# Layout authority is intentionally duplicated here so the service does NOT depend
# on any config file. Keep in sync with ~/.config/hypr/hyprland/custom/monitors.conf:
#   DP-1  Dell P2417H  -> x=0     (LEFT)
#   DP-2  Dell P2719H  -> x=1920  (CENTER)
#   DP-3  Lenovo T24i  -> x=3840  (RIGHT)
set -u

LAYOUT=(
  "DP-1, 1920x1080@60, 0x0, 1"
  "DP-2, 1920x1080@60, 1920x0, 1"
  "DP-3, 1920x1080@60, 3840x0, 1"
)

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
hyprdir="$runtime/hypr"
log() { echo "jarvos-monitor-layout: $*"; }

# Wait (up to ~30s) for a LIVE Hyprland IPC, then bind to that instance.
deadline=$(( $(date +%s) + 30 ))
sig=""
while [ "$(date +%s)" -le "$deadline" ]; do
  for d in "$hyprdir"/*/; do
    [ -S "${d}.socket.sock" ] || continue
    cand="$(basename "$d")"
    if HYPRLAND_INSTANCE_SIGNATURE="$cand" hyprctl monitors -j >/dev/null 2>&1; then
      sig="$cand"
      break
    fi
  done
  [ -n "$sig" ] && break
  sleep 0.5
done

if [ -z "$sig" ]; then
  log "no live Hyprland instance found within timeout; nothing to do"
  exit 0
fi
export HYPRLAND_INSTANCE_SIGNATURE="$sig"

for rule in "${LAYOUT[@]}"; do
  hyprctl keyword monitor "$rule" >/dev/null 2>&1
done
log "applied layout (DP-1|DP-2|DP-3 = left|center|right) to instance $sig"
exit 0
