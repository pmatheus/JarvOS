#!/usr/bin/env bash
# jarvos-vpn — one VPN client for every vendor.
#
# jarvos:summary=Connect to any VPN vendor through a single profile-driven client
# jarvos:args=list|status|connect <profile>|disconnect [--json] [--dry-run]
# jarvos:examples=jarvos-vpn list | jarvos-vpn connect work | jarvos-vpn status
#
# Corporate VPNs each ship their own Linux client, each of them a different
# amount of broken. Underneath, almost all of them speak a protocol openconnect
# already implements, so a profile names a vendor and this dispatches to the
# binary that speaks it:
#
#   globalprotect  gpclient   — openconnect underneath, but its SAML/SSO flow
#                               needs gpauth, which is why raw openconnect is
#                               not enough for a Panorama-managed portal
#   fortinet       openconnect --protocol=fortinet
#   anyconnect     openconnect --protocol=anyconnect   (Cisco, ocserv)
#   f5             openconnect --protocol=f5
#   pulse          openconnect --protocol=pulse        (Juniper/Ivanti)
#   juniper        openconnect --protocol=nc           (legacy Network Connect)
#   array          openconnect --protocol=array
#   checkpoint     snx-rs — the one protocol openconnect does not implement
#
# gpclient and gpauth are GPL-3.0 (package globalprotect-openconnect). The
# licensed piece of that project is gpgui, the GUI, which this replaces — so
# nothing here depends on a trial.
#
# Profiles: ~/.config/jarvos/vpn/profiles.json, a list of
#   {name, vendor, server, [gateway], [user], [browser], [interface], [hip]}
# Credentials never live there — see the refusal in load_profile().

set -euo pipefail

# shellcheck source=lib/jarvos-common.sh
_lib="$(dirname "$(realpath "$0")")/../lib/jarvos-common.sh"
if [[ -r "$_lib" ]]; then source "$_lib"; else source /usr/share/jarvos/lib/jarvos-common.sh; fi
unset _lib

PROFILES="${JARVOS_VPN_PROFILES:-${XDG_CONFIG_HOME:-$HOME/.config}/jarvos/vpn/profiles.json}"

# Vendor names as people say them, not as binaries spell them. A Palo Alto
# portal is usually called "Panorama" by the people running it.
canonical_vendor() {
    case "${1,,}" in
        globalprotect | global-protect | gp | panorama | paloalto | palo-alto | pan) echo globalprotect ;;
        fortinet | fortigate | forti) echo fortinet ;;
        anyconnect | cisco | ocserv) echo anyconnect ;;
        f5 | bigip | big-ip) echo f5 ;;
        pulse | ivanti) echo pulse ;;
        juniper | nc | networkconnect) echo juniper ;;
        array) echo array ;;
        checkpoint | check-point | snx) echo checkpoint ;;
        *) return 1 ;;
    esac
}

SUPPORTED="globalprotect (panorama), fortinet, anyconnect, f5, pulse, juniper, array, checkpoint"

read_profiles() {
    [[ -r "$PROFILES" ]] || {
        echo "[]"
        return 0
    }
    jq -e . "$PROFILES" 2>/dev/null || die "cannot read profiles: $PROFILES is not valid JSON"
}

# The live tunnel, if any. Matched on link kind rather than name because every
# client names its interface differently; tailscale0 is the same kind and is
# excluded because it is not a VPN in this sense and has its own indicator.
tunnel_json() {
    ip -j -d addr show 2>/dev/null |
        jq -c '[.[]
            | select(.ifname != "tailscale0")
            | select((.linkinfo.info_kind // "") | IN("tun","tap","wireguard","ppp"))
            | {name: .ifname, ip: (.addr_info[]? | select(.family=="inet") | .local)}
        ] | .[0] // null' 2>/dev/null || echo null
}

cmd_status() {
    local tun
    tun="$(tunnel_json)"

    if [[ "${1-}" == "--json" ]]; then
        if [[ "$tun" == "null" ]]; then
            echo '{"connected":false}'
        else
            jq -nc --argjson t "$tun" '{connected:true, interface:$t.name, address:$t.ip}'
        fi
        [[ "$tun" != "null" ]]
        return
    fi

    [[ "$tun" == "null" ]] && {
        echo "disconnected"
        return 1
    }
    printf 'connected: %s on %s\n' "$(jq -r .ip <<<"$tun")" "$(jq -r .name <<<"$tun")"
}

cmd_list() {
    local profiles
    profiles="$(read_profiles)"

    if [[ "${1-}" == "--json" ]]; then
        printf '%s\n' "$profiles"
        return 0
    fi

    if [[ "$(jq 'length' <<<"$profiles")" -eq 0 ]]; then
        printf 'No VPN profiles yet. Add one to %s:\n' "$PROFILES"
        printf '  [{"name": "work", "vendor": "panorama", "server": "vpn.example.com"}]\n'
        printf 'Vendors: %s\n' "$SUPPORTED"
        return 0
    fi

    jq -r '.[] | "\(.name)\t\(.vendor)\t\(.server)"' <<<"$profiles" | column -t -s$'\t'
}

load_profile() {
    local name="$1" profiles profile
    profiles="$(read_profiles)"
    profile="$(jq -c --arg n "$name" '.[] | select(.name == $n)' <<<"$profiles")"

    [[ -n "$profile" ]] || {
        local have
        have="$(jq -r '[.[].name] | join(", ")' <<<"$profiles")"
        die "no such profile: $name (have: ${have:-none})"
    }

    # A profile is config, and config gets copied into chats, pasted into issues
    # and committed by accident. GlobalProtect authenticates through SSO and
    # openconnect prompts, so nothing here ever needs a stored password — and a
    # file that accepts one becomes the place people put them. The value is
    # never echoed back.
    if jq -e 'has("password") or has("passwd") or has("secret")' <<<"$profile" >/dev/null; then
        die "profile '$name' contains a password; put credentials in the vault, not in $PROFILES"
    fi

    printf '%s' "$profile"
}

build_command() {
    local profile="$1" vendor server gateway user browser iface hip
    server="$(jq -r '.server // ""' <<<"$profile")"
    gateway="$(jq -r '.gateway // ""' <<<"$profile")"
    user="$(jq -r '.user // ""' <<<"$profile")"
    browser="$(jq -r '.browser // "default"' <<<"$profile")"
    iface="$(jq -r '.interface // ""' <<<"$profile")"
    hip="$(jq -r '.hip // ""' <<<"$profile")"

    [[ -n "$server" ]] || die "profile has no server"

    vendor="$(canonical_vendor "$(jq -r '.vendor // ""' <<<"$profile")")" ||
        die "unsupported vendor '$(jq -r '.vendor' <<<"$profile")' — supported: $SUPPORTED"

    local -a cmd
    case "$vendor" in
        globalprotect)
            # gpclient wraps openconnect and drives the SAML exchange through
            # gpauth. --browser keeps that in the user's own browser instead of
            # the licensed GUI's embedded one.
            cmd=(sudo gpclient connect "$server" --browser "$browser")
            [[ -n "$gateway" ]] && cmd+=(--gateway "$gateway")
            [[ -n "$user" ]] && cmd+=(--user "$user")
            [[ -n "$iface" ]] && cmd+=(--interface "$iface")
            [[ -n "$hip" ]] && cmd+=(--hip "$hip")
            ;;
        checkpoint)
            command -v snx-rs >/dev/null 2>&1 ||
                echo "jarvos-vpn: snx-rs is not installed (yay -S snx-rs) — Checkpoint is the one protocol openconnect does not implement" >&2
            cmd=(sudo snx-rs -s "$server")
            [[ -n "$user" ]] && cmd+=(-u "$user")
            ;;
        *)
            local proto="$vendor"
            [[ "$vendor" == "juniper" ]] && proto=nc
            cmd=(sudo openconnect "--protocol=$proto" "$server")
            [[ -n "$user" ]] && cmd+=(--user "$user")
            [[ -n "$iface" ]] && cmd+=(--interface "$iface")
            ;;
    esac

    printf '%s\n' "${cmd[*]}"
}

cmd_connect() {
    local name="${1-}" dry=""
    [[ -n "$name" && "$name" != --* ]] || die "usage: jarvos-vpn connect <profile> [--dry-run]"
    shift
    [[ "${1-}" == "--dry-run" ]] && dry=1

    local profile line
    profile="$(load_profile "$name")"
    line="$(build_command "$profile")"

    if [[ -n "$dry" ]]; then
        printf '%s\n' "$line"
        return 0
    fi

    printf 'Connecting %s…\n' "$name"
    # Deliberately word-split: build_command emits a command line, and every
    # component in it comes from a validated profile field.
    # shellcheck disable=SC2086
    eval "$line"
}

cmd_disconnect() {
    local tun
    tun="$(tunnel_json)"
    [[ "$tun" == "null" ]] && {
        echo "already disconnected"
        return 0
    }

    # gpclient owns its own session and must be told, rather than having its
    # interface pulled from under it.
    if command -v gpclient >/dev/null 2>&1 && pgrep -x gpclient >/dev/null 2>&1; then
        sudo gpclient disconnect
        return
    fi
    sudo pkill -TERM -x openconnect 2>/dev/null || true
    sudo pkill -TERM -x snx-rs 2>/dev/null || true
}

case "${1-}" in
    list) shift; cmd_list "$@" ;;
    status) shift; cmd_status "$@" ;;
    connect) shift; cmd_connect "$@" ;;
    disconnect) shift; cmd_disconnect "$@" ;;
    -h | --help) sed -n '2,32p' "$0" ;;
    *) die "usage: jarvos-vpn list|status|connect <profile>|disconnect" ;;
esac
