#!/usr/bin/env bash
# jarvos-agent-stratagem [banner|wrap <prompt>|random|all]
#
# jarvos:summary=Generate or inject the Chinese 36 Stratagems strategic system prompt in CN, EN, and PT-BR
# jarvos:args=[banner|wrap <prompt>|random|all]
# jarvos:examples=jarvos-agent-stratagem banner | jarvos-agent-stratagem wrap "fix this bug"

set -euo pipefail

# shellcheck source=lib/jarvos-common.sh
_lib="$(dirname "$(realpath "$0")")/../lib/jarvos-common.sh"
if [[ -r "$_lib" ]]; then source "$_lib"; else source /usr/share/jarvos/lib/jarvos-common.sh; fi
unset _lib

REPO_ROOT="$(dirname "$(realpath "$0")")/.."
DATA_FILE="$REPO_ROOT/share/jarvos/stratagems.json"
if [[ ! -f "$DATA_FILE" ]]; then
    DATA_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/jarvos/stratagems.json"
fi

[[ -f "$DATA_FILE" ]] || die "stratagems data file not found: $DATA_FILE"

cmd="${1:-banner}"
shift || true

case "$cmd" in
    banner)
        python3 - "$DATA_FILE" << 'PYEOF'
import json, random, sys

data = json.load(open(sys.argv[1]))
item = random.choice(data)

banner = f"""[STRATEGIC SYSTEM DOCTRINE • 战略系统心法 • DOUTRINA ESTRATÉGICA DO SISTEMA]
🇨🇳 中文: {item['cn']} ({item['pinyin']})
🇬🇧 EN:   {item['en']}
🇧🇷 PT-BR: {item['pt']}
--------------------------------------------------------------------------------"""
print(banner)
PYEOF
        ;;

    wrap)
        prompt="${1:-}"
        [[ -n "$prompt" ]] || die "usage: jarvos-agent-stratagem wrap <prompt>"
        banner="$("$0" banner)"
        printf '%s\n\n%s\n' "$banner" "$prompt"
        ;;

    random)
        python3 - "$DATA_FILE" << 'PYEOF'
import json, random, sys
data = json.load(open(sys.argv[1]))
print(json.dumps(random.choice(data), ensure_ascii=False, indent=2))
PYEOF
        ;;

    all)
        python3 - "$DATA_FILE" << 'PYEOF'
import json, sys
data = json.load(open(sys.argv[1]))
print(f"{'ID':<4} {'CHINESE':<14} {'PINYIN':<30} {'ENGLISH':<32} {'PORTUGUÊS'}")
print(f"{'-'*4} {'-'*14} {'-'*30} {'-'*32} {'-'*32}")
for it in data:
    print(f"{it['id']:<4} {it['cn']:<14} {it['pinyin']:<30} {it['en']:<32} {it['pt']}")
PYEOF
        ;;

    -h|--help)
        sed -n '2,6p' "$0"
        exit 0
        ;;

    *)
        die "unknown subcommand: $cmd (available: banner, wrap, random, all)"
        ;;
esac
