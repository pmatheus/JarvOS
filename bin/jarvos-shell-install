#!/usr/bin/env bash
# Prepare the pinned Omarchy shell without running its system installer.
set -euo pipefail
case "${1:---prepare}" in
    --help|-h)
        echo 'Usage: jarvos-shell-install [--prepare|--activate|--rollback BACKUP]'
        echo 'Preserves existing Omarchy preferences. Saves overwritten integration files in a timestamped backup.'
        exit 0 ;;
    --prepare|--activate|--rollback) mode=${1:---prepare} ;;
    *) echo 'Usage: jarvos-shell-install [--prepare|--activate]' >&2; exit 2 ;;
esac
if [[ "$mode" == --rollback ]]; then
    backup=${2:?Supply the backup directory printed by preparation}
    [[ -f "$backup/config.tar.gz" && -f "$backup/created.txt" ]] || exit 1
    if tar -xOf "$backup/config.tar.gz" .config/systemd/user/quickshell-jarvos.service 2>/dev/null | grep -q 'qs -c caelestia'; then
        pacman -Q caelestia-shell caelestia-cli >/dev/null 2>&1 || {
            echo 'Restore the saved Caelestia packages with pacman -U before rolling back.' >&2
            exit 1
        }
    fi
    rollback_dir="$backup/after-rollback/$(date +%Y%m%d-%H%M%S-%N)"
    mkdir -p "$rollback_dir"
    while IFS= read -r path; do
        case "$path" in
            .config/omarchy|.config/systemd/user/quickshell-jarvos.service|.config/hypr/hyprland/custom/zz-jarvos-omarchy.conf|.config/hypr/hyprland/execs.conf|.config/hypr/hyprlock/sync-wallpaper.sh|.local/bin/jarvos-shell|.local/bin/jarvos-shell-install) ;;
            *) echo "Unexpected backup path: $path" >&2; exit 1 ;;
        esac
    done < "$backup/created.txt"
    systemctl --user stop quickshell-jarvos.service
    tar -czf "$rollback_dir/existing.tar.gz" -C "$HOME" -T "$backup/existed.txt"
    while IFS= read -r path; do
        if [[ -e "$HOME/$path" || -L "$HOME/$path" ]]; then
            mkdir -p "$rollback_dir/$(dirname "$path")"
            mv "$HOME/$path" "$rollback_dir/$path"
        fi
    done < "$backup/created.txt"
    tar -xzf "$backup/config.tar.gz" -C "$HOME"
    systemctl --user daemon-reload
    if [[ -f "$HOME/.config/systemd/user/quickshell-jarvos.service" ]]; then
        systemctl --user start quickshell-jarvos.service
    fi
    hyprctl reload
    exit 0
fi
base=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
assets="$base/share/jarvos/omarchy"
defaults="$base/config/.config"
if [[ ! -d "$assets" ]]; then
    assets=/usr/share/jarvos/omarchy
    defaults=/usr/share/jarvos/config/.config
fi
read -r revision < "$assets/upstream.commit"
upstream="$HOME/.local/share/omarchy"
backup="$HOME/.local/state/jarvos/omarchy-migration/$(date +%Y%m%d-%H%M%S-%N)"
for cmd in git jq qs tar fc-cache; do
    command -v "$cmd" >/dev/null || { echo "Missing dependency: $cmd" >&2; exit 1; }
done
if [[ ! -d "$upstream/.git" ]]; then
    [[ ! -e "$upstream" ]] || { echo "Refusing to replace $upstream" >&2; exit 1; }
    git clone --no-checkout --depth 1 https://github.com/omacom/omarchy.git "$upstream"
    git -C "$upstream" fetch --depth 1 origin "$revision"
    git -C "$upstream" checkout --detach "$revision"
fi
[[ $(git -C "$upstream" rev-parse HEAD) == "$revision" ]] || {
    echo "Omarchy revision differs from JarvOS pin $revision. No files deployed." >&2
    exit 1
}
[[ -z $(git -C "$upstream" status --porcelain) ]] || {
    echo 'Upstream checkout has local changes. No files deployed.' >&2
    exit 1
}
mkdir -p "$backup"
paths=(.config/omarchy .config/systemd/user/quickshell-jarvos.service
    .config/hypr/hyprland/custom/zz-jarvos-omarchy.conf
    .config/hypr/hyprland/execs.conf .config/hypr/hyprlock/sync-wallpaper.sh
    .local/bin/jarvos-shell .local/bin/jarvos-shell-install)
for path in "${paths[@]}"; do
    if [[ -e "$HOME/$path" || -L "$HOME/$path" ]]; then
        printf '%s\n' "$path" >> "$backup/existed.txt"
    else
        printf '%s\n' "$path" >> "$backup/created.txt"
    fi
done
touch "$backup/existed.txt" "$backup/created.txt"
tar -czf "$backup/config.tar.gz" -C "$HOME" -T "$backup/existed.txt"
mkdir -p "$HOME/.config/omarchy" "$HOME/.config/omarchy/extensions" \
    "$HOME/.config/omarchy/plugins" "$HOME/.config/omarchy/themes" \
    "$HOME/.local/bin" "$HOME/.config/systemd/user" \
    "$HOME/.config/hypr/hyprland/custom" "$HOME/.local/share/fonts/omarchy" \
    "$HOME/.local/state/omarchy/current"
for config in shell.json extensions/omarchy-menu.jsonc; do
    if [[ ! -e "$HOME/.config/omarchy/$config" ]]; then
        cp "$defaults/omarchy/$config" "$HOME/.config/omarchy/$config"
    fi
done
for plugin in jarvos.identity jarvos.agents; do
    cp -a "$defaults/omarchy/plugins/$plugin" "$HOME/.config/omarchy/plugins/"
done
if [[ ! -d "$HOME/.config/omarchy/themes/jarvos" ]]; then
    cp -a "$defaults/omarchy/themes/jarvos" "$HOME/.config/omarchy/themes/"
fi
if [[ ! -f "$HOME/.local/state/omarchy/current/theme/colors.toml" ]]; then
    mkdir -p "$HOME/.local/state/omarchy/current/theme"
    cp "$HOME/.config/omarchy/themes/jarvos/colors.toml" "$HOME/.local/state/omarchy/current/theme/"
    printf 'jarvos\n' > "$HOME/.local/state/omarchy/current/theme.name"
fi
if [[ ! -e "$HOME/.local/state/omarchy/current/background" ]]; then
    if [[ -f "$HOME/.cache/hyprlock-wallpaper" ]]; then
        wallpaper=$(readlink -f "$HOME/.cache/hyprlock-wallpaper")
    else
        wallpaper=$(find "$upstream/themes" -path '*/backgrounds/*' -type f -print -quit)
    fi
    if [[ -n "$wallpaper" ]]; then
        ln -sfn "$wallpaper" "$HOME/.local/state/omarchy/current/background"
    fi
fi
cp "$defaults/systemd/user/quickshell-jarvos.service" "$HOME/.config/systemd/user/"
cp "$defaults/hypr/hyprland/custom/zz-jarvos-omarchy.conf" "$HOME/.config/hypr/hyprland/custom/"
# Remove only the former shell's competing wallpaper and clipboard owners.
execs="$HOME/.config/hypr/hyprland/execs.conf"
if [[ -f "$execs" ]]; then
    sed -i -E '/^exec-once[[:space:]]*=.*awww-daemon/d; /^(exec-once[[:space:]]*=).*quickshell\/scripts\/colors\/applycolor\.sh/d; /^exec-once[[:space:]]*=.*wl-paste.*--watch cliphist store/d' "$execs"
fi
mkdir -p "$HOME/.config/hypr/hyprlock"
cp "$defaults/hypr/hyprlock/sync-wallpaper.sh" "$HOME/.config/hypr/hyprlock/"
ln -sfn "$base/bin/jarvos-shell" "$HOME/.local/bin/jarvos-shell"
ln -sfn "$base/bin/jarvos-shell-install" "$HOME/.local/bin/jarvos-shell-install"
cp "$upstream/default/fonts/omarchy/omarchy.ttf" "$HOME/.local/share/fonts/omarchy/"
fc-cache "$HOME/.local/share/fonts/omarchy"
printf '%s\n' "$backup" > "$HOME/.local/state/jarvos/omarchy-migration/latest"
echo "Prepared Omarchy $revision. Backup: $backup"
if [[ "$mode" == --activate ]]; then
    activate() {
        systemctl --user daemon-reload || return 1
        systemctl --user restart quickshell-jarvos.service || return 1
        hyprctl reload || return 1
        for _ in 1 2 3 4 5; do
            if [[ $("$base/bin/jarvos-shell" status 2>/dev/null || true) == ok ]]; then return 0; fi
            sleep 1
        done
        return 1
    }
    if activate; then exit 0; fi
    echo "Shell did not become ready. Restoring $backup/config.tar.gz." >&2
    "$base/bin/jarvos-shell-install" --rollback "$backup"
    exit 1
fi
