#!/usr/bin/env bash
# jarvos-update-keyring — refresh archlinux-keyring on its own.
#
# Runs before the main transaction. A stale keyring fails the whole upgrade
# unrecoverably, and it fails it in the middle, which is the worst place.
#
# A keyring too stale to verify its own replacement is repopulated from the
# keys pacman already ships, then given one more try. Exit 75 means the
# mirrors were unreachable.

set -euo pipefail

# shellcheck source=lib/jarvos-common.sh
_lib="$(dirname "$(realpath "$0")")/../lib/jarvos-common.sh"
if [[ -r "$_lib" ]]; then source "$_lib"; else source /usr/share/jarvos/lib/jarvos-common.sh; fi
unset _lib

log="$(mktemp)"
trap 'rm -f "$log"' EXIT

refresh() {
    local rc=0
    sudo pacman -Sy --needed --noconfirm archlinux-keyring 2>&1 | tee "$log" || rc=${PIPESTATUS[0]}
    return "$rc"
}

jarvos_pacman_unlock_stale || true

echo "Refreshing the package signing keys"
refresh && exit 0

if jarvos_network_failure "$log"; then
    echo "jarvos: the package mirrors could not be reached — retry later" >&2
    exit "$JARVOS_EX_TEMPFAIL"
fi

echo "jarvos: the keyring refresh failed — repopulating it and retrying"
sudo pacman-key --populate archlinux || true
refresh
