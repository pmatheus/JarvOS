{
  "root": {"title": "JarvOS", "label": "JarvOS"},
  "apps": {"label": "Aplicativos"},
  "learn": {"when": "false"},
  "trigger": {"when": "false"},
  "style": {"when": "false"},
  "setup": {"when": "false"},
  "install": {"when": "false"},
  "remove": {"when": "false"},
  "update": {"when": "false"},
  "about": {"when": "false"},
  "system": {"label": "Sessão"},
  "system.screensaver": {"when": "false"},
  "system.lock": {"label": "Bloquear", "action": "jarvos-shell lock"},
  "system.logout": {"label": "Sair", "action": "hyprctl dispatch exit"},
  "system.suspend": {"label": "Suspender"},
  "system.reboot": {"label": "Reiniciar", "action": "systemctl reboot"},
  "system.shutdown": {"label": "Desligar", "action": "systemctl poweroff"},
  "desktop": {"label": "Desktop", "icon": "󰍹"},
  "desktop.theme": {"label": "Tema", "action": "jarvos-shell theme", "icon": "󰸌"},
  "desktop.wallpaper": {"label": "Wallpaper", "action": "jarvos-shell wallpaper", "icon": "󰸉"},
  "desktop.audio": {"label": "Áudio", "action": "jarvos-shell audio", "icon": "󰕾"},
  "desktop.network": {"label": "Rede", "action": "jarvos-shell network", "icon": "󰖩"},
  "desktop.bluetooth": {"label": "Bluetooth", "action": "jarvos-shell bluetooth", "icon": "󰂯"},
  "desktop.display": {"label": "Monitores", "action": "jarvos-shell display", "icon": "󰍹"},
  "desktop.notifications": {"label": "Notificações", "action": "jarvos-shell notifications", "icon": "󰂚"},
  "jarvos": {"label": "Ferramentas JarvOS", "icon": "󰚩"},
  "jarvos.agents": {"label": "Agents", "action": "jarvos-agent-pick"},
  "jarvos.setup": {"label": "Módulos opcionais", "action": "jarvos-setup"},
  "jarvos.chinese": {"label": "Chinês", "action": "jarvos-chinese"},
  "jarvos.terminal": {"label": "Terminal", "action": "kitty"},
  "jarvos.screenshot": {"label": "Capturar região", "action": "~/.config/hypr/hyprland/scripts/hypr-snip.sh"},
  "jarvos.record": {"label": "Gravar tela / parar gravação", "action": "jarvos-shell record"},
  "jarvos.maintain": {"label": "Atualizar sistema", "action": "kitty -e jarvos-update"},
  "jarvos.restart": {"label": "Reiniciar desktop", "action": "jarvos-shell restart"},
  "jarvos-setup": {"label": "Módulos opcionais", "title": "JarvOS Setup", "when": "false"},
  "jarvos-setup.apps": {"label": "Instalar aplicativos", "action": "kitty --hold -e jarvos-setup --install apps"},
  "jarvos-setup.ai": {"label": "Instalar ferramentas de IA", "action": "kitty --hold -e jarvos-setup --install ai"},
  "jarvos-setup.dev": {"label": "Instalar desenvolvimento", "action": "kitty --hold -e jarvos-setup --install dev"},
  "jarvos-setup.security": {"label": "Instalar ferramentas de segurança", "action": "kitty --hold -e jarvos-setup --install security"},
  "jarvos-setup.media": {"label": "Instalar ferramentas de mídia", "action": "kitty --hold -e jarvos-setup --install media"},
  "jarvos-setup.i18n": {"label": "Instalar idiomas e fontes", "action": "kitty --hold -e jarvos-setup --install i18n"},
  "jarvos-setup.system": {"label": "Instalar ferramentas de sistema", "action": "kitty --hold -e jarvos-setup --install system"},
  "jarvos-setup.terminal": {"label": "Instalar ferramentas de terminal", "action": "kitty --hold -e jarvos-setup --install terminal"},
  "jarvos-setup.done": {"label": "Concluir configuração", "action": "jarvos-setup --done"}
}
