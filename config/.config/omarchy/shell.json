    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [{"id": "jarvos.identity"}, {"id": "omarchy.workspaces"}],
      "center": [{"id": "omarchy.clock", "format": "ddd  HH:mm", "formatAlt": "d MMMM yyyy"}],
      "right": [
        {"id": "omarchy.weather"},
        {"id": "omarchy.media"},
        {"id": "omarchy.tray"},
        {"id": "jarvos.agents"},
        {"id": "omarchy.bluetooth"},
        {"id": "omarchy.network"},
        {"id": "omarchy.audio"},
        {"id": "omarchy.monitor"},
        {"id": "omarchy.power"}
      ]
    }
  },
  "plugins": []
}
