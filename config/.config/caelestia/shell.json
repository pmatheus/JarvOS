{
  "appearance": {
    "font": {
      "family": {
        "clock": "Rubik",
        "material": "Material Symbols Rounded",
        "mono": "JetBrains Mono NF",
        "sans": "Rubik"
      }
    },
    "transparency": {
      "enabled": true,
      "base": 0.85,
      "layers": 0.4
    }
  },
  "general": {
    "logo": "~/.config/quickshell/assets/icons/arch-symbolic.svg",
    "apps": {
      "terminal": [
        "kitty",
        "-1"
      ],
      "audio": [
        "pavucontrol-qt"
      ],
      "playback": [
        "mpv"
      ],
      "explorer": [
        "nautilus"
      ]
    }
  },
  "background": {
    "enabled": false
  },
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "dragThreshold": 20,
    "entries": [
      {
        "id": "logo",
        "enabled": false
      },
      {
        "id": "workspaces",
        "enabled": false
      },
      {
        "id": "networkInfo",
        "enabled": true
      },
      {
        "id": "spacer",
        "enabled": true
      },
      {
        "id": "dateWidget",
        "enabled": true
      },
      {
        "id": "spacer",
        "enabled": true
      },
      {
        "id": "agentStatus",
        "enabled": true
      },
      {
        "id": "tray",
        "enabled": true
      },
      {
        "id": "clock",
        "enabled": true
      },
      {
        "id": "networkSpeed",
        "enabled": true
      },
      {
        "id": "statusIcons",
        "enabled": false
      },
      {
        "id": "power",
        "enabled": true
      }
    ],
    "popouts": {
      "activeWindow": true,
      "statusIcons": false,
      "tray": true
    },
    "scrollActions": {
      "brightness": true,
      "workspaces": true,
      "volume": true
    },
    "workspaces": {
      "perMonitorWorkspaces": true,
      "shown": 5,
      "activeIndicator": true,
      "showWindows": true,
      "occupiedBg": true
    },
    "status": {
      "showAudio": false,
      "showBattery": false,
      "showBluetooth": false,
      "showNetwork": false,
      "showWifi": false,
      "showMicrophone": false,
      "showLockStatus": false
    }
  },
  "border": {
    "rounding": 15,
    "thickness": 2
  },
  "dashboard": {
    "enabled": true,
    "showOnHover": false
  },
  "launcher": {
    "maxShown": 7,
    "showOnHover": false,
    "actions": [
      {
        "name": "Calculator",
        "icon": "calculate",
        "description": "Do simple math equations",
        "command": [
          "autocomplete",
          "calc"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Wallpaper",
        "icon": "image",
        "description": "Change the current wallpaper",
        "command": [
          "autocomplete",
          "wallpaper"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Settings",
        "icon": "settings",
        "description": "Configure the shell",
        "command": [
          "caelestia",
          "shell",
          "controlCenter",
          "open"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Lock",
        "icon": "lock",
        "description": "Lock the session",
        "command": [
          "loginctl",
          "lock-session"
        ],
        "enabled": true,
        "dangerous": false
      },
      {
        "name": "Shutdown",
        "icon": "power_settings_new",
        "description": "Shutdown the system",
        "command": [
          "systemctl",
          "poweroff"
        ],
        "enabled": true,
        "dangerous": true
      },
      {
        "name": "Reboot",
        "icon": "cached",
        "description": "Reboot the system",
        "command": [
          "systemctl",
          "reboot"
        ],
        "enabled": true,
        "dangerous": true
      }
    ]
  },
  "notifs": {
    "expire": true,
    "defaultExpireTimeout": 5000
  },
  "osd": {
    "enabled": true,
    "enableBrightness": true
  },
  "paths": {
    "wallpaperDir": "~/Pictures/Wallpapers"
  },
  "services": {
    "useTwelveHourClock": false,
    "weatherLocation": ""
  },
  "session": {
    "enabled": true
  },
  "sidebar": {
    "enabled": true
  },
  "utilities": {
    "enabled": true,
    "maxToasts": 4,
    "toasts": {
      "audioInputChanged": true,
      "audioOutputChanged": true,
      "capsLockChanged": true,
      "chargingChanged": true,
      "configLoaded": true,
      "dndChanged": true,
      "gameModeChanged": true,
      "kbLayoutChanged": true,
      "vpnChanged": true
    },
    "vpn": {
      "enabled": true,
      "provider": []
    },
    "quickToggles": [
      {
        "id": "wifi",
        "enabled": true
      },
      {
        "id": "bluetooth",
        "enabled": true
      },
      {
        "id": "mic",
        "enabled": true
      },
      {
        "id": "settings",
        "enabled": true
      },
      {
        "id": "gameMode",
        "enabled": true
      },
      {
        "id": "dnd",
        "enabled": true
      },
      {
        "id": "vpn",
        "enabled": true
      }
    ]
  }
}
