*/monitors.conf
monitors.conf
*/colors.conf
colors.conf
*/scheme/*
*machine-id*
.claude/.current_system.json*
.claude/.arsenal-manifest.json
.config/hypr/hyprland/custom/monitors.conf
.local/state/*

# ── re-fetchable checkouts and caches (restored from their manifests) ────
.claude/plugins/cache/*
.claude/plugins/marketplaces/*
.claude/plugins/data/*
.claude/plugins/install-counts-cache.json
*/node_modules/*
*/__pycache__/*
*/.venv/*
*/venv/*
*/.mypy_cache/*
*/.ruff_cache/*
*/.pytest_cache/*
.git/*
*/.git/*

