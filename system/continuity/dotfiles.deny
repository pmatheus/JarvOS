.claude/paste-cache/*
.claude/file-history/*
.claude/shell-snapshots/*
.claude/statsig/*
.claude/logs/*
.claude/debug/*
.claude/cache/*
.claude/backups/*
.claude/jobs/*
.claude/daemon/*
.claude/ide/*
.claude/.claude.json*
.claude/security_warnings_state_*
.claude/.last-*
.claude/agent-memory/*
.claude/memory/*

